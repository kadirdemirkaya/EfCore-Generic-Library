<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>EfCore.RepositoryPack</PackageId>
		<Authors>Kadir Demirkaya</Authors>
		<Description>Provides a generic repository pattern implementation for Entity Framework Core, supporting all SQL-based databases.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/kadirdemirkaya/EfCore-Generic-Library</RepositoryUrl>
		<PackageTags>efcore;repository;entityframework;sql;database;dataaccess</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>2.0.0 (breaking, shared version with EfCore.BaseRepositoryPack): targets .NET 8, 9 and 10 with patched EF Core versions. New ExecuteQueryInterpolatedAsync sends interpolated values as SQL parameters; the unparameterized ExecuteQueryAsync(string) is removed. The public _dbContext members of the repositories, Table and UnitOfWork are removed (use Table or GetTable()), as is ParameterValidationAttribute. Includes every fix since 1.3.0: shared context for one-by-one registrations, all-or-nothing list inserts, composite key updates, ordered pagination, nullable annotations.</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/kadirdemirkaya/EfCore-Generic-Library</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Base.Repository\Base.Repository.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.33" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
	</ItemGroup>

</Project>
