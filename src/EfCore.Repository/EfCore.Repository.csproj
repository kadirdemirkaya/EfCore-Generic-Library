<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageId>EfCore.RepositoryPack</PackageId>
		<Authors>Kadir Demirkaya</Authors>
		<Description>Provides a generic repository pattern implementation for Entity Framework Core, supporting all SQL-based databases.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/kadirdemirkaya/EfCore-Generic-Library</RepositoryUrl>
		<PackageTags>efcore;repository;entityframework;sql;database;dataaccess</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>2.1.0 (shared version with EfCore.BaseRepositoryPack, no breaking changes): unit of work across entities with transactions and cancellable saves, update without saving, set-based DeleteWhereAsync/UpdateWhereAsync, split query / ignore query filters / identity resolution options, StreamAsync, keyset pagination and page navigation flags, fluent specification builder with And/Or/Not predicates, LongCountAsync, ExecuteCommandInterpolatedAsync, faster assembly-scan registration and primary key checks through the EF Core model. See CHANGELOG.</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/kadirdemirkaya/EfCore-Generic-Library</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Base.Repository\Base.Repository.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.33" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.22" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
	</ItemGroup>

</Project>
