<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Authors>Kadir Demirkaya</Authors>
		<PackageId>EfCore.BaseRepositoryPack</PackageId>
		<Description>Provides base abstractions and helpers for the EfCore.RepositoryPack library, including options, interfaces, and shared logic.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/kadirdemirkaya/EfCore-Generic-Library</RepositoryUrl>
		<PackageTags>EfCore.RepositoryPack</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>2.0.0 (breaking, shared version with EfCore.RepositoryPack): targets .NET 8, 9 and 10 with patched EF Core and Microsoft.Extensions versions. Removed IBaseReadRepository.ExecuteQueryAsync(string) (use ExecuteQueryInterpolatedAsync or ExecuteQueryAsync(string, params object[])), DatabaseOptions.RetryCount and IsRetry, and ConfigurationHelpers.GetOptions(IServiceCollection, string). GetByIdAsync returns a nullable entity.</PackageReleaseNotes>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/kadirdemirkaya/EfCore-Generic-Library</PackageProjectUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<None Include="docs\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.33" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.22" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="9.0.22" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.14" />
	</ItemGroup>

</Project>
